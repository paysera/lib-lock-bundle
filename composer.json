{
    "name": "paysera/lib-lock-bundle",
    "type": "symfony-bundle",
    "description": "Provides utilities to organize Locks in your system",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Paysera\\Bundle\\LockBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paysera\\Bundle\\LockBundle\\Test\\": "test"
        }
    },
    "require": {
        "php": ">=7.1",
        "symfony/lock": "^4.4.2 || ^5.4 || ^6.0 || ^7.4",
        "symfony/config": "^4.4 || ^5.0 || ^6.0 || ^7.4",
        "symfony/dependency-injection": "^4.4 || ^5.0 || ^6.0 || ^7.4",
        "symfony/http-kernel": "^4.4 || ^5.0 || ^6.0 || ^7.4"
    },
    "suggest": {
        "predis/predis": "To store locks in Redis"
    },
    "require-dev": {
        "predis/predis": "^1.1.10 || ^2.0",
        "phpunit/phpunit": "^7.5.15 || ^8.5.21 || ^9.6",
        "symfony/framework-bundle": "^4.4 || ^5.0 || ^6.0 || ^7.4",
        "symfony/filesystem": "^4.4 || ^5.0 || ^6.0 || ^7.4",
        "symfony/yaml": "^4.0 || ^5.0 || ^6.0 || ^7.4"
    },
    "config": {
        "bin-dir": "bin"
    },
    "scripts": {
        "test": [
            "@test:phpunit"
        ],
        "test:phpunit": "bin/phpunit"
    },
    "scripts-descriptions": {
        "test": "Runs all tests",
        "test:phpunit": "Runs PHPUnit tests"
    }
}
